    <!--
        NexusStream launcher foreground: the website's "N" zigzag lettermark + the stream
        dot, in crisp white. The solid purple rounded-square background is supplied by the
        adaptive-icon <background> (colors.xml → ic_launcher_background), so this foreground
        is artwork-only and stays legible on any launcher skin.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22 76 L22 24 L54 52 L76 24 L76 76 L66 76 L44 50 L32 76 Z" />
    <!-- Stream dot (VectorDrawable has no <circle>: the disc is two 180-degree arcs). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M75,74.5 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 Z" />
</vector>
